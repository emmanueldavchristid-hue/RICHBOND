generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  RESPONSABLE_ACHATS
  ACHETEUR
  MAGASINIER
}

enum PurchaseScope {
  LOCAL
  IMPORT
  ALL
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  EXPIRED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          Role
  purchaseScope PurchaseScope? @map("purchase_scope")
  active        Boolean        @default(true)
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  sessionVersion     Int       @default(0) @map("session_version")
  deactivatedAt      DateTime? @map("deactivated_at")
  createdById        String?   @map("created_by_id")

  createdBy User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  created   User[] @relation("UserCreatedBy")

  auditLogs AuditLog[]

  purchaseRequestsCreated  PurchaseRequest[]      @relation("PurchaseRequestCreator")
  purchaseRequestsApproved PurchaseRequest[]      @relation("PurchaseRequestApprover")
  purchaseRequestsAssigned PurchaseRequest[]      @relation("PurchaseRequestBuyer")
  purchaseRequestEvents    PurchaseRequestEvent[]
  notifications            Notification[]

  @@index([role, active])
  @@map("users")
}

model Counter {
  key       String
  year      Int
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([key, year])
  @@map("counters")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model License {
  id             String        @id @default(cuid())
  status         LicenseStatus
  trialStartsAt  DateTime      @map("trial_starts_at")
  trialEndsAt    DateTime      @map("trial_ends_at")
  licensedTo     String?       @map("licensed_to")
  activatedAt    DateTime?     @map("activated_at")
  keyFingerprint String?       @map("key_fingerprint")
  /// Garantit une seule ligne : valeur true unique (NULL autorisé pour d'éventuels doublons historiques).
  singleton      Boolean?      @unique @default(true)
  /// Plus grande heure serveur observée (anti-recul d'horloge).
  lastSeenAt     DateTime?     @map("last_seen_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("licenses")
}

// ---------------------------------------------------------------- LOT-03 : référentiels

enum ItemCategory {
  MATIERE_PREMIERE
  INTRANT
  PDR
  FOURNITURE
  SERVICE
}

enum Criticality {
  CRITIQUE
  IMPORTANT
  STANDARD
}

enum ItemStatus {
  ACTIF
  BLOQUE
  OBSOLETE
}

enum SupplierType {
  LOCAL
  IMPORT
}

enum SupplierStatus {
  ACTIF
  EN_EVALUATION
  BLOQUE
}

enum PaymentTerm {
  COMPTANT
  J30
  J45
  J60
  J90
  FIN_DE_MOIS_30
  AUTRE
}

enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

enum PriceSource {
  MANUEL
  BC
  FACTURE
}

model Warehouse {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items Item[]

  @@map("warehouses")
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchaseRequests PurchaseRequest[]

  @@map("departments")
}

model Currency {
  code        String   @id
  name        String
  symbol      String
  decimals    Int      @default(2)
  isBase      Boolean  @default(false) @map("is_base")
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rates     ExchangeRate[]
  suppliers Supplier[]

  @@map("currencies")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  currencyCode String   @map("currency_code")
  date         DateTime @db.Date
  /// FCFA pour 1 unité de devise.
  rate         Decimal  @db.Decimal(14, 6)
  note         String?
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  currency Currency @relation(fields: [currencyCode], references: [code])

  @@unique([currencyCode, date])
  @@map("exchange_rates")
}

model Supplier {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  type            SupplierType
  country         String         @default("CI")
  city            String?
  address         String?
  phone           String?
  email           String?
  /// Coordonnées bancaires / RIB, texte libre (à ne pas diffuser).
  bankDetails     String?        @map("bank_details")
  currencyCode    String         @map("currency_code")
  ncc             String?        @unique
  rccm            String?
  paymentTerm     PaymentTerm    @default(J30) @map("payment_term")
  paymentTermNote String?        @map("payment_term_note")
  incoterm        Incoterm?
  leadTimeDays    Int?           @map("lead_time_days")
  categories      ItemCategory[]
  status          SupplierStatus @default(ACTIF)
  blockedReason   String?        @map("blocked_reason")
  blockedAt       DateTime?      @map("blocked_at")
  blockedById     String?        @map("blocked_by_id")
  notes           String?
  createdById     String?        @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  currency  Currency          @relation(fields: [currencyCode], references: [code])
  contacts  SupplierContact[]
  items     ItemSupplier[]
  mainItems Item[]

  @@index([status, type])
  @@index([name])
  @@map("suppliers")
}

model SupplierContact {
  id          String   @id @default(cuid())
  supplierId  String   @map("supplier_id")
  name        String
  role        String?
  phone       String?
  email       String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("supplier_contacts")
}

model Item {
  id                 String       @id @default(cuid())
  code               String       @unique
  name               String
  category           ItemCategory
  family             String?
  stockUnit          String       @map("stock_unit")
  purchaseUnit       String       @map("purchase_unit")
  conversionFactor   Decimal      @default(1) @map("conversion_factor") @db.Decimal(14, 3)
  stocked            Boolean      @default(true)
  criticality        Criticality  @default(STANDARD)
  abcClass           String?      @map("abc_class")
  defaultWarehouseId String?      @map("default_warehouse_id")
  safetyStock        Decimal?     @map("safety_stock") @db.Decimal(14, 3)
  reorderPoint       Decimal?     @map("reorder_point") @db.Decimal(14, 3)
  economicOrderQty   Decimal?     @map("economic_order_qty") @db.Decimal(14, 3)
  leadTimeDays       Int?         @map("lead_time_days")
  mainSupplierId     String?      @map("main_supplier_id")
  barcode            String?      @unique
  status             ItemStatus   @default(ACTIF)
  equipment          String?
  photoPath          String?      @map("photo_path")
  notes              String?
  createdById        String?      @map("created_by_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  defaultWarehouse Warehouse?            @relation(fields: [defaultWarehouseId], references: [id])
  mainSupplier     Supplier?             @relation(fields: [mainSupplierId], references: [id])
  suppliers        ItemSupplier[]
  priceHistory     ItemPriceHistory[]
  requestLines     PurchaseRequestLine[]

  @@index([category, status])
  @@index([criticality])
  @@index([name])
  @@index([equipment])
  @@map("items")
}

model ItemSupplier {
  id            String    @id @default(cuid())
  itemId        String    @map("item_id")
  supplierId    String    @map("supplier_id")
  supplierRef   String?   @map("supplier_ref")
  lastPrice     Decimal?  @map("last_price") @db.Decimal(14, 2)
  currencyCode  String?   @map("currency_code")
  lastPriceDate DateTime? @map("last_price_date")
  /// Unité du prix et du minimum de commande = unité d'achat de l'article au moment de la saisie.
  priceUnit     String?   @map("price_unit")
  leadTimeDays  Int?      @map("lead_time_days")
  minOrderQty   Decimal?  @map("min_order_qty") @db.Decimal(14, 3)
  active        Boolean   @default(true)
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  item     Item     @relation(fields: [itemId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([itemId, supplierId])
  @@index([supplierId])
  @@map("item_suppliers")
}

model ItemPriceHistory {
  id           String      @id @default(cuid())
  itemId       String      @map("item_id")
  supplierId   String      @map("supplier_id")
  price        Decimal     @db.Decimal(14, 2)
  currencyCode String      @map("currency_code")
  rateToXof    Decimal?    @map("rate_to_xof") @db.Decimal(14, 6)
  /// Unité d'achat de l'article à la date du prix.
  priceUnit    String?     @map("price_unit")
  source       PriceSource @default(MANUEL)
  sourceRef    String?     @map("source_ref")
  date         DateTime
  createdById  String?     @map("created_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId, date])
  @@map("item_price_history")
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ---------------------------------------------------------------- LOT-04 : demandes d'achat

enum PurchaseRequestStatus {
  BROUILLON
  SOUMISE
  A_COMPLETER
  VALIDEE
  REFUSEE
  EN_CONSULTATION
  PARTIELLEMENT_COMMANDEE
  COMMANDEE
  ANNULEE
}

enum PurchaseRequestUrgency {
  NORMALE
  URGENTE
  ARRET_PRODUCTION
}

enum PurchaseRequestType {
  LOCAL
  IMPORT
  A_DEFINIR
}

enum PurchaseRequestKind {
  STANDARD
  REAPPRO
}

enum PurchaseRequestEventType {
  CREATED
  UPDATED
  SUBMITTED
  RESUBMITTED
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
  ASSIGNED
  QTY_CHANGED
  COMMENT
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  STATUS_SYNC
}

enum NotificationSeverity {
  INFO
  IMPORTANT
  CRITIQUE
}

model PurchaseRequest {
  id              String                 @id @default(cuid())
  /// Null au brouillon ; DA-AAAA-NNNNN attribué à la première soumission, jamais réattribué.
  number          String?                @unique
  status          PurchaseRequestStatus  @default(BROUILLON)
  kind            PurchaseRequestKind    @default(STANDARD)
  urgency         PurchaseRequestUrgency @default(NORMALE)
  /// 0 arrêt de production, 1 urgente, 2 normale : tri sans dépendre de l'ordre d'un enum.
  priority        Int                    @default(2)
  type            PurchaseRequestType    @default(A_DEFINIR)
  departmentId    String                 @map("department_id")
  requesterName   String                 @map("requester_name")
  reason          String
  neededBy        DateTime               @map("needed_by") @db.Date
  /// FCFA entiers, somme des lignes chiffrées.
  estimatedTotal  Int?                   @map("estimated_total")
  createdById     String                 @map("created_by_id")
  submittedAt     DateTime?              @map("submitted_at")
  approvedAt      DateTime?              @map("approved_at")
  approvedById    String?                @map("approved_by_id")
  rejectedReason  String?                @map("rejected_reason")
  cancelledReason String?                @map("cancelled_reason")
  cancelledAt     DateTime?              @map("cancelled_at")
  cancelledById   String?                @map("cancelled_by_id")
  assignedBuyerId String?                @map("assigned_buyer_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  department    Department                  @relation(fields: [departmentId], references: [id])
  createdBy     User                        @relation("PurchaseRequestCreator", fields: [createdById], references: [id])
  approvedBy    User?                       @relation("PurchaseRequestApprover", fields: [approvedById], references: [id])
  assignedBuyer User?                       @relation("PurchaseRequestBuyer", fields: [assignedBuyerId], references: [id])
  lines         PurchaseRequestLine[]
  events        PurchaseRequestEvent[]
  attachments   PurchaseRequestAttachment[]

  @@index([status, priority, neededBy])
  @@index([createdById])
  @@index([assignedBuyerId, status])
  @@index([departmentId])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                 String   @id @default(cuid())
  requestId          String   @map("request_id")
  lineNo             Int      @map("line_no")
  itemId             String?  @map("item_id")
  freeDesignation    String?  @map("free_designation")
  /// Quantité demandée (unité saisie).
  quantity           Decimal  @db.Decimal(14, 3)
  /// Quantité validée par le Responsable (0 = ligne retirée) ; null avant décision.
  approvedQty        Decimal? @map("approved_qty") @db.Decimal(14, 3)
  unit               String
  /// Quantité demandée convertie en unité de stock.
  stockQty           Decimal? @map("stock_qty") @db.Decimal(14, 3)
  /// FCFA par unité saisie.
  estimatedUnitPrice Int?     @map("estimated_unit_price")
  note               String?

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item    Item?           @relation(fields: [itemId], references: [id])

  @@unique([requestId, lineNo])
  @@index([itemId])
  @@map("purchase_request_lines")
}

model PurchaseRequestEvent {
  id         String                   @id @default(cuid())
  requestId  String                   @map("request_id")
  type       PurchaseRequestEventType
  userId     String                   @map("user_id")
  fromStatus PurchaseRequestStatus?   @map("from_status")
  toStatus   PurchaseRequestStatus?   @map("to_status")
  comment    String?
  payload    Json?
  createdAt  DateTime                 @default(now()) @map("created_at")

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])

  @@index([requestId, createdAt])
  @@map("purchase_request_events")
}

model PurchaseRequestAttachment {
  id           String    @id @default(cuid())
  requestId    String    @map("request_id")
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  size         Int
  /// Nom de fichier généré côté serveur (jamais saisi par l'utilisateur).
  path         String
  uploadedById String    @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  removedAt    DateTime? @map("removed_at")

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("purchase_request_attachments")
}

model Notification {
  id          String               @id @default(cuid())
  recipientId String               @map("recipient_id")
  type        String
  severity    NotificationSeverity @default(INFO)
  title       String
  body        String?
  link        String
  entity      String?
  entityId    String?              @map("entity_id")
  readAt      DateTime?            @map("read_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}
