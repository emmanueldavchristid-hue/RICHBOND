generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  RESPONSABLE_ACHATS
  ACHETEUR
  MAGASINIER
}

enum PurchaseScope {
  LOCAL
  IMPORT
  ALL
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  EXPIRED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          Role
  purchaseScope PurchaseScope? @map("purchase_scope")
  active        Boolean        @default(true)
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  sessionVersion     Int       @default(0) @map("session_version")
  deactivatedAt      DateTime? @map("deactivated_at")
  createdById        String?   @map("created_by_id")

  createdBy User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  created   User[] @relation("UserCreatedBy")

  auditLogs AuditLog[]

  purchaseRequestsCreated  PurchaseRequest[]      @relation("PurchaseRequestCreator")
  purchaseRequestsApproved PurchaseRequest[]      @relation("PurchaseRequestApprover")
  purchaseRequestsAssigned PurchaseRequest[]      @relation("PurchaseRequestBuyer")
  purchaseRequestEvents    PurchaseRequestEvent[]
  notifications            Notification[]

  purchaseOrdersCreated  PurchaseOrder[]      @relation("PurchaseOrderCreator")
  purchaseOrdersApproved PurchaseOrder[]      @relation("PurchaseOrderApprover")
  purchaseOrderEvents    PurchaseOrderEvent[]

  receiptsCreated Receipt[]        @relation("ReceiptCreator")
  stockMovements  StockMovement[]
  stockIssues     StockIssue[]
  supplierReturns SupplierReturn[]
  inventoryCountsCreated   InventoryCount[] @relation("InventoryCreator")
  inventoryCountsValidated InventoryCount[] @relation("InventoryValidator")

  @@index([role, active])
  @@map("users")
}

model Counter {
  key       String
  year      Int
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([key, year])
  @@map("counters")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model License {
  id             String        @id @default(cuid())
  status         LicenseStatus
  trialStartsAt  DateTime      @map("trial_starts_at")
  trialEndsAt    DateTime      @map("trial_ends_at")
  licensedTo     String?       @map("licensed_to")
  activatedAt    DateTime?     @map("activated_at")
  keyFingerprint String?       @map("key_fingerprint")
  /// Garantit une seule ligne : valeur true unique (NULL autorisé pour d'éventuels doublons historiques).
  singleton      Boolean?      @unique @default(true)
  /// Plus grande heure serveur observée (anti-recul d'horloge).
  lastSeenAt     DateTime?     @map("last_seen_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("licenses")
}

// ---------------------------------------------------------------- LOT-03 : référentiels

enum ItemCategory {
  MATIERE_PREMIERE
  INTRANT
  PDR
  FOURNITURE
  SERVICE
}

enum Criticality {
  CRITIQUE
  IMPORTANT
  STANDARD
}

enum ItemStatus {
  ACTIF
  BLOQUE
  OBSOLETE
}

enum SupplierType {
  LOCAL
  IMPORT
}

enum SupplierStatus {
  ACTIF
  EN_EVALUATION
  BLOQUE
}

enum PaymentTerm {
  COMPTANT
  J30
  J45
  J60
  J90
  FIN_DE_MOIS_30
  AUTRE
}

enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

enum PriceSource {
  MANUEL
  BC
  FACTURE
}

model Warehouse {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  /// Adresse de livraison imprimée sur les bons de commande.
  address     String?
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items           Item[]
  purchaseOrders  PurchaseOrder[]
  receipts        Receipt[]
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  inventoryCounts InventoryCount[]
  stockIssues     StockIssue[]
  supplierReturns SupplierReturn[]

  @@map("warehouses")
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchaseRequests PurchaseRequest[]
  stockIssues      StockIssue[]

  @@map("departments")
}

model Currency {
  code        String   @id
  name        String
  symbol      String
  decimals    Int      @default(2)
  isBase      Boolean  @default(false) @map("is_base")
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rates          ExchangeRate[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]

  @@map("currencies")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  currencyCode String   @map("currency_code")
  date         DateTime @db.Date
  /// FCFA pour 1 unité de devise.
  rate         Decimal  @db.Decimal(14, 6)
  note         String?
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  currency Currency @relation(fields: [currencyCode], references: [code])

  @@unique([currencyCode, date])
  @@map("exchange_rates")
}

model Supplier {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  type            SupplierType
  country         String         @default("CI")
  city            String?
  address         String?
  phone           String?
  email           String?
  /// Coordonnées bancaires / RIB, texte libre (à ne pas diffuser).
  bankDetails     String?        @map("bank_details")
  currencyCode    String         @map("currency_code")
  ncc             String?        @unique
  rccm            String?
  paymentTerm     PaymentTerm    @default(J30) @map("payment_term")
  paymentTermNote String?        @map("payment_term_note")
  incoterm        Incoterm?
  leadTimeDays    Int?           @map("lead_time_days")
  categories      ItemCategory[]
  status          SupplierStatus @default(ACTIF)
  blockedReason   String?        @map("blocked_reason")
  blockedAt       DateTime?      @map("blocked_at")
  blockedById     String?        @map("blocked_by_id")
  notes           String?
  createdById     String?        @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  currency        Currency          @relation(fields: [currencyCode], references: [code])
  contacts        SupplierContact[]
  items           ItemSupplier[]
  mainItems       Item[]
  purchaseOrders  PurchaseOrder[]
  receipts        Receipt[]
  nonConformities NonConformity[]
  supplierReturns SupplierReturn[]

  @@index([status, type])
  @@index([name])
  @@map("suppliers")
}

model SupplierContact {
  id          String   @id @default(cuid())
  supplierId  String   @map("supplier_id")
  name        String
  role        String?
  phone       String?
  email       String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("supplier_contacts")
}

model Item {
  id                 String       @id @default(cuid())
  code               String       @unique
  name               String
  category           ItemCategory
  family             String?
  stockUnit          String       @map("stock_unit")
  purchaseUnit       String       @map("purchase_unit")
  conversionFactor   Decimal      @default(1) @map("conversion_factor") @db.Decimal(14, 3)
  stocked            Boolean      @default(true)
  criticality        Criticality  @default(STANDARD)
  abcClass           String?      @map("abc_class")
  defaultWarehouseId String?      @map("default_warehouse_id")
  safetyStock        Decimal?     @map("safety_stock") @db.Decimal(14, 3)
  reorderPoint       Decimal?     @map("reorder_point") @db.Decimal(14, 3)
  economicOrderQty   Decimal?     @map("economic_order_qty") @db.Decimal(14, 3)
  leadTimeDays       Int?         @map("lead_time_days")
  mainSupplierId     String?      @map("main_supplier_id")
  barcode            String?      @unique
  status             ItemStatus   @default(ACTIF)
  equipment          String?
  photoPath          String?      @map("photo_path")
  /// Dernier calcul de la classe ABC (LOT-07).
  abcComputedAt      DateTime?    @map("abc_computed_at")
  notes              String?
  createdById        String?      @map("created_by_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  defaultWarehouse Warehouse?            @relation(fields: [defaultWarehouseId], references: [id])
  mainSupplier     Supplier?             @relation(fields: [mainSupplierId], references: [id])
  suppliers        ItemSupplier[]
  priceHistory     ItemPriceHistory[]
  requestLines     PurchaseRequestLine[]
  orderLines       PurchaseOrderLine[]
  receiptLines     ReceiptLine[]
  nonConformities  NonConformity[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  issueLines       StockIssueLine[]
  returnLines      SupplierReturnLine[]
  inventoryLines   InventoryCountLine[]

  @@index([category, status])
  @@index([criticality])
  @@index([name])
  @@index([equipment])
  @@map("items")
}

model ItemSupplier {
  id            String    @id @default(cuid())
  itemId        String    @map("item_id")
  supplierId    String    @map("supplier_id")
  supplierRef   String?   @map("supplier_ref")
  lastPrice     Decimal?  @map("last_price") @db.Decimal(14, 2)
  currencyCode  String?   @map("currency_code")
  lastPriceDate DateTime? @map("last_price_date")
  /// Unité du prix et du minimum de commande = unité d'achat de l'article au moment de la saisie.
  priceUnit     String?   @map("price_unit")
  leadTimeDays  Int?      @map("lead_time_days")
  minOrderQty   Decimal?  @map("min_order_qty") @db.Decimal(14, 3)
  active        Boolean   @default(true)
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  item     Item     @relation(fields: [itemId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([itemId, supplierId])
  @@index([supplierId])
  @@map("item_suppliers")
}

model ItemPriceHistory {
  id           String      @id @default(cuid())
  itemId       String      @map("item_id")
  supplierId   String      @map("supplier_id")
  price        Decimal     @db.Decimal(14, 2)
  currencyCode String      @map("currency_code")
  rateToXof    Decimal?    @map("rate_to_xof") @db.Decimal(14, 6)
  /// Unité d'achat de l'article à la date du prix.
  priceUnit    String?     @map("price_unit")
  source       PriceSource @default(MANUEL)
  sourceRef    String?     @map("source_ref")
  date         DateTime
  createdById  String?     @map("created_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId, date])
  @@map("item_price_history")
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ---------------------------------------------------------------- LOT-04 : demandes d'achat

enum PurchaseRequestStatus {
  BROUILLON
  SOUMISE
  A_COMPLETER
  VALIDEE
  REFUSEE
  EN_CONSULTATION
  PARTIELLEMENT_COMMANDEE
  COMMANDEE
  ANNULEE
}

enum PurchaseRequestUrgency {
  NORMALE
  URGENTE
  ARRET_PRODUCTION
}

enum PurchaseRequestType {
  LOCAL
  IMPORT
  A_DEFINIR
}

enum PurchaseRequestKind {
  STANDARD
  REAPPRO
}

enum PurchaseRequestEventType {
  CREATED
  UPDATED
  SUBMITTED
  RESUBMITTED
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
  ASSIGNED
  QTY_CHANGED
  COMMENT
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  STATUS_SYNC
}

enum NotificationSeverity {
  INFO
  IMPORTANT
  CRITIQUE
}

model PurchaseRequest {
  id              String                 @id @default(cuid())
  /// Null au brouillon ; DA-AAAA-NNNNN attribué à la première soumission, jamais réattribué.
  number          String?                @unique
  status          PurchaseRequestStatus  @default(BROUILLON)
  kind            PurchaseRequestKind    @default(STANDARD)
  urgency         PurchaseRequestUrgency @default(NORMALE)
  /// 0 arrêt de production, 1 urgente, 2 normale : tri sans dépendre de l'ordre d'un enum.
  priority        Int                    @default(2)
  type            PurchaseRequestType    @default(A_DEFINIR)
  departmentId    String                 @map("department_id")
  requesterName   String                 @map("requester_name")
  reason          String
  neededBy        DateTime               @map("needed_by") @db.Date
  /// FCFA entiers, somme des lignes chiffrées.
  estimatedTotal  Int?                   @map("estimated_total")
  createdById     String                 @map("created_by_id")
  submittedAt     DateTime?              @map("submitted_at")
  approvedAt      DateTime?              @map("approved_at")
  approvedById    String?                @map("approved_by_id")
  rejectedReason  String?                @map("rejected_reason")
  cancelledReason String?                @map("cancelled_reason")
  cancelledAt     DateTime?              @map("cancelled_at")
  cancelledById   String?                @map("cancelled_by_id")
  assignedBuyerId String?                @map("assigned_buyer_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  department    Department                  @relation(fields: [departmentId], references: [id])
  createdBy     User                        @relation("PurchaseRequestCreator", fields: [createdById], references: [id])
  approvedBy    User?                       @relation("PurchaseRequestApprover", fields: [approvedById], references: [id])
  assignedBuyer User?                       @relation("PurchaseRequestBuyer", fields: [assignedBuyerId], references: [id])
  lines         PurchaseRequestLine[]
  events        PurchaseRequestEvent[]
  attachments   PurchaseRequestAttachment[]

  @@index([status, priority, neededBy])
  @@index([createdById])
  @@index([assignedBuyerId, status])
  @@index([departmentId])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                 String   @id @default(cuid())
  requestId          String   @map("request_id")
  lineNo             Int      @map("line_no")
  itemId             String?  @map("item_id")
  freeDesignation    String?  @map("free_designation")
  /// Quantité demandée (unité saisie).
  quantity           Decimal  @db.Decimal(14, 3)
  /// Quantité validée par le Responsable (0 = ligne retirée) ; null avant décision.
  approvedQty        Decimal? @map("approved_qty") @db.Decimal(14, 3)
  unit               String
  /// Quantité demandée convertie en unité de stock.
  stockQty           Decimal? @map("stock_qty") @db.Decimal(14, 3)
  /// FCFA par unité saisie.
  estimatedUnitPrice Int?     @map("estimated_unit_price")
  note               String?

  request     PurchaseRequest               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item        Item?                         @relation(fields: [itemId], references: [id])
  allocations PurchaseOrderLineAllocation[]

  @@unique([requestId, lineNo])
  @@index([itemId])
  @@map("purchase_request_lines")
}

model PurchaseRequestEvent {
  id         String                   @id @default(cuid())
  requestId  String                   @map("request_id")
  type       PurchaseRequestEventType
  userId     String                   @map("user_id")
  fromStatus PurchaseRequestStatus?   @map("from_status")
  toStatus   PurchaseRequestStatus?   @map("to_status")
  comment    String?
  payload    Json?
  createdAt  DateTime                 @default(now()) @map("created_at")

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])

  @@index([requestId, createdAt])
  @@map("purchase_request_events")
}

model PurchaseRequestAttachment {
  id           String    @id @default(cuid())
  requestId    String    @map("request_id")
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  size         Int
  /// Nom de fichier généré côté serveur (jamais saisi par l'utilisateur).
  path         String
  uploadedById String    @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  removedAt    DateTime? @map("removed_at")

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("purchase_request_attachments")
}

model Notification {
  id          String               @id @default(cuid())
  recipientId String               @map("recipient_id")
  type        String
  severity    NotificationSeverity @default(INFO)
  title       String
  body        String?
  link        String
  entity      String?
  entityId    String?              @map("entity_id")
  readAt      DateTime?            @map("read_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------- LOT-05 : bons de commande

enum PurchaseOrderStatus {
  BROUILLON
  A_VALIDER
  VALIDE
  ENVOYE
  CONFIRME
  PARTIELLEMENT_RECU
  RECU
  CLOTURE
  REFUSE
  ANNULE
}

enum PurchaseOrderType {
  LOCAL
  IMPORT
}

enum PurchaseOrderOrigin {
  DA
  DIRECT
  OFFRE
}

enum ContactChannel {
  EMAIL
  WHATSAPP
  TELEPHONE
  REMIS_EN_MAIN
  AUTRE
}

enum PurchaseOrderEventType {
  CREATED
  UPDATED
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
  SENT
  CONFIRMED
  PROMISED_DATE_CHANGED
  REMINDED
  AMENDMENT_STARTED
  AMENDMENT_ABANDONED
  CLOSED
  COMMENT
  STATUS_SYNC
}

model PurchaseOrder {
  id                  String               @id @default(cuid())
  /// Null jusqu'à la validation ; BC-AAAA-NNNNN attribué à la validation, jamais réattribué (un avenant garde le numéro).
  number              String?              @unique
  version             Int                  @default(1)
  /// Pendant un avenant : statut à retrouver si l'avenant est refusé ou abandonné.
  resumeStatus        PurchaseOrderStatus? @map("resume_status")
  status              PurchaseOrderStatus  @default(BROUILLON)
  type                PurchaseOrderType
  origin              PurchaseOrderOrigin  @default(DA)
  directReason        String?              @map("direct_reason")
  supplierId          String               @map("supplier_id")
  createdById         String               @map("created_by_id")
  currencyCode        String               @map("currency_code")
  /// FCFA pour 1 unité de devise : indicatif en brouillon, figé à la validation.
  exchangeRate        Decimal?             @map("exchange_rate") @db.Decimal(14, 6)
  rateDate            DateTime?            @map("rate_date") @db.Date
  paymentTerm         PaymentTerm          @map("payment_term")
  paymentTermNote     String?              @map("payment_term_note")
  incoterm            Incoterm?
  incotermPlace       String?              @map("incoterm_place")
  warehouseId         String               @map("warehouse_id")
  deliveryAddress     String               @default("") @map("delivery_address")
  requestedDate       DateTime             @map("requested_date") @db.Date
  promisedDate        DateTime?            @map("promised_date") @db.Date
  firstPromisedDate   DateTime?            @map("first_promised_date") @db.Date
  promisedDateChanges Int                  @default(0) @map("promised_date_changes")
  /// promisedDate ?? requestedDate, recalculé à chaque écriture (filtre et tri des retards).
  expectedDate        DateTime             @map("expected_date") @db.Date
  supplierRef         String?              @map("supplier_ref")
  notes               String?
  internalNote        String?              @map("internal_note")
  /// Montants dans la devise du BC.
  totalHt             Decimal              @default(0) @map("total_ht") @db.Decimal(16, 2)
  totalVat            Decimal              @default(0) @map("total_vat") @db.Decimal(16, 2)
  totalTtc            Decimal              @default(0) @map("total_ttc") @db.Decimal(16, 2)
  /// Équivalents FCFA entiers (null si aucun taux connu).
  totalHtXof          Int?                 @map("total_ht_xof")
  totalTtcXof         Int?                 @map("total_ttc_xof")
  submittedAt         DateTime?            @map("submitted_at")
  approvedAt          DateTime?            @map("approved_at")
  approvedById        String?              @map("approved_by_id")
  rejectedReason      String?              @map("rejected_reason")
  sentAt              DateTime?            @map("sent_at")
  sentChannel         ContactChannel?      @map("sent_channel")
  confirmedAt         DateTime?            @map("confirmed_at")
  lastRemindedAt      DateTime?            @map("last_reminded_at")
  reminderCount       Int                  @default(0) @map("reminder_count")
  cancelledAt         DateTime?            @map("cancelled_at")
  cancelledById       String?              @map("cancelled_by_id")
  cancelledReason     String?              @map("cancelled_reason")
  closedAt            DateTime?            @map("closed_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  supplier   Supplier               @relation(fields: [supplierId], references: [id])
  createdBy  User                   @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  approvedBy User?                  @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  currency   Currency               @relation(fields: [currencyCode], references: [code])
  warehouse  Warehouse              @relation(fields: [warehouseId], references: [id])
  lines      PurchaseOrderLine[]
  charges    PurchaseOrderCharge[]
  events     PurchaseOrderEvent[]
  versions   PurchaseOrderVersion[]

  receipts        Receipt[]
  nonConformities NonConformity[]
  supplierReturns SupplierReturn[]

  @@index([status, expectedDate])
  @@index([supplierId, status])
  @@index([createdById, status])
  @@index([type, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  lineNo          Int      @map("line_no")
  itemId          String?  @map("item_id")
  freeDesignation String?  @map("free_designation")
  supplierRef     String?  @map("supplier_ref")
  /// Quantité commandée, en unité d'achat.
  quantity        Decimal  @db.Decimal(14, 3)
  unit            String
  stockQty        Decimal? @map("stock_qty") @db.Decimal(14, 3)
  /// Prix unitaire en devise du BC (entier si XOF).
  unitPrice       Decimal  @map("unit_price") @db.Decimal(14, 2)
  discountPct     Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  vatRate         Decimal  @map("vat_rate") @db.Decimal(5, 2)
  netAmount       Decimal  @map("net_amount") @db.Decimal(16, 2)
  /// Dernier prix d'achat connu (FCFA par unité d'achat) au moment de la soumission.
  lastPriceXof    Int?     @map("last_price_xof")
  priceDeltaPct   Decimal? @map("price_delta_pct") @db.Decimal(7, 2)
  receivedQty     Decimal  @default(0) @map("received_qty") @db.Decimal(14, 3)
  invoicedQty     Decimal  @default(0) @map("invoiced_qty") @db.Decimal(14, 3)
  /// Reliquat soldé (unité d'achat) : reçu + soldé >= commandé => ligne complète.
  closedQty       Decimal  @default(0) @map("closed_qty") @db.Decimal(14, 3)
  closedReason    String?  @map("closed_reason")
  note            String?

  order        PurchaseOrder                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item         Item?                         @relation(fields: [itemId], references: [id])
  allocations  PurchaseOrderLineAllocation[]
  receiptLines ReceiptLine[]

  @@unique([orderId, lineNo])
  @@index([itemId])
  @@map("purchase_order_lines")
}

/// Rattachement d'une ligne de BC au besoin (ligne de DA) qu'elle couvre ; quantité dans l'unité de la ligne de DA.
model PurchaseOrderLineAllocation {
  id            String  @id @default(cuid())
  orderLineId   String  @map("order_line_id")
  requestLineId String  @map("request_line_id")
  qty           Decimal @db.Decimal(14, 3)

  orderLine   PurchaseOrderLine   @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  requestLine PurchaseRequestLine @relation(fields: [requestLineId], references: [id])

  @@unique([orderLineId, requestLineId])
  @@index([requestLineId])
  @@map("purchase_order_line_allocations")
}

model PurchaseOrderCharge {
  id      String  @id @default(cuid())
  orderId String  @map("order_id")
  label   String
  amount  Decimal @db.Decimal(14, 2)
  vatRate Decimal @map("vat_rate") @db.Decimal(5, 2)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("purchase_order_charges")
}

model PurchaseOrderEvent {
  id         String                 @id @default(cuid())
  orderId    String                 @map("order_id")
  version    Int                    @default(1)
  type       PurchaseOrderEventType
  userId     String                 @map("user_id")
  fromStatus PurchaseOrderStatus?   @map("from_status")
  toStatus   PurchaseOrderStatus?   @map("to_status")
  comment    String?
  payload    Json?
  createdAt  DateTime               @default(now()) @map("created_at")

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
  @@map("purchase_order_events")
}

/// Instantané JSON de chaque version validée : PDF de toute version régénérable, restauration après un avenant refusé.
model PurchaseOrderVersion {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  version      Int
  snapshot     Json
  approvedAt   DateTime @map("approved_at")
  approvedById String   @map("approved_by_id")

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, version])
  @@map("purchase_order_versions")
}

// ---------------------------------------------------------------- LOT-06 / LOT-07 : réceptions et stock

enum ReceiptStatus {
  VALIDEE
  ANNULEE
}

enum RefusalReason {
  ABIME
  NON_CONFORME
  ERREUR_REFERENCE
  HORS_DELAI
  AUTRE
}

enum NonConformityDecision {
  RETOUR
  AVOIR
  REMPLACEMENT
}

enum NonConformityStatus {
  OUVERTE
  CLOTUREE
}

enum SupplierReturnStatus {
  VALIDE
  ANNULE
}

enum StockMovementType {
  ENTREE_RECEPTION
  SORTIE
  RETOUR_FOURNISSEUR
  TRANSFERT
  AJUSTEMENT
  AJUSTEMENT_INVENTAIRE
}

enum StockDocumentType {
  RECEPTION
  SORTIE
  RETOUR
  TRANSFERT
  AJUSTEMENT
  INVENTAIRE
}

enum StockIssueStatus {
  VALIDEE
  ANNULEE
}

model Receipt {
  id                       String        @id @default(cuid())
  /// REC-AAAA-NNNNN, attribué à la validation (réception en une étape).
  number                   String        @unique
  status                   ReceiptStatus @default(VALIDEE)
  orderId                  String        @map("order_id")
  supplierId               String        @map("supplier_id")
  warehouseId              String        @map("warehouse_id")
  deliveryNoteRef          String        @map("delivery_note_ref")
  receivedAt               DateTime      @map("received_at") @db.Date
  carrier                  String?
  comment                  String?
  /// firstPromisedDate ?? requestedDate du BC au moment de la réception.
  referenceDate            DateTime      @map("reference_date") @db.Date
  daysLate                 Int           @default(0) @map("days_late")
  /// BC soldé après cette réception.
  inFull                   Boolean       @default(false) @map("in_full")
  overDeliveryApprovedById String?       @map("over_delivery_approved_by_id")
  overDeliveryReason       String?       @map("over_delivery_reason")
  createdById              String        @map("created_by_id")
  createdAt                DateTime      @default(now()) @map("created_at")
  cancelledAt              DateTime?     @map("cancelled_at")
  cancelledById            String?       @map("cancelled_by_id")
  cancelledReason          String?       @map("cancelled_reason")

  order           PurchaseOrder   @relation(fields: [orderId], references: [id])
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy       User            @relation("ReceiptCreator", fields: [createdById], references: [id])
  lines           ReceiptLine[]
  nonConformities NonConformity[]

  @@index([orderId])
  @@index([receivedAt])
  @@index([supplierId, receivedAt])
  @@map("receipts")
}

model ReceiptLine {
  id               String         @id @default(cuid())
  receiptId        String         @map("receipt_id")
  orderLineId      String         @map("order_line_id")
  itemId           String?        @map("item_id")
  /// Quantités en unité d'achat du BC.
  deliveredQty     Decimal        @map("delivered_qty") @db.Decimal(14, 3)
  acceptedQty      Decimal        @map("accepted_qty") @db.Decimal(14, 3)
  refusedQty       Decimal        @default(0) @map("refused_qty") @db.Decimal(14, 3)
  /// Quantité acceptée convertie en unité de stock.
  acceptedStockQty Decimal        @map("accepted_stock_qty") @db.Decimal(14, 3)
  refusalReason    RefusalReason? @map("refusal_reason")
  lotNumber        String?        @map("lot_number")
  /// FCFA par unité de stock.
  unitCostXof      Decimal        @map("unit_cost_xof") @db.Decimal(14, 4)

  receipt         Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine       PurchaseOrderLine @relation(fields: [orderLineId], references: [id])
  item            Item?             @relation(fields: [itemId], references: [id])
  movements       StockMovement[]
  nonConformities NonConformity[]

  @@index([receiptId])
  @@index([orderLineId])
  @@index([itemId])
  @@map("receipt_lines")
}

model NonConformity {
  id            String                 @id @default(cuid())
  /// NC-AAAA-NNNNN.
  number        String                 @unique
  supplierId    String                 @map("supplier_id")
  orderId       String                 @map("order_id")
  receiptId     String                 @map("receipt_id")
  receiptLineId String                 @map("receipt_line_id")
  itemId        String?                @map("item_id")
  /// Quantité refusée, unité d'achat.
  qty           Decimal                @db.Decimal(14, 3)
  reason        RefusalReason
  decision      NonConformityDecision?
  status        NonConformityStatus    @default(OUVERTE)
  comment       String?
  decidedById   String?                @map("decided_by_id")
  decidedAt     DateTime?              @map("decided_at")
  createdAt     DateTime               @default(now()) @map("created_at")

  supplier    Supplier      @relation(fields: [supplierId], references: [id])
  order       PurchaseOrder @relation(fields: [orderId], references: [id])
  receipt     Receipt       @relation(fields: [receiptId], references: [id])
  receiptLine ReceiptLine   @relation(fields: [receiptLineId], references: [id])
  item        Item?         @relation(fields: [itemId], references: [id])

  @@index([status, createdAt])
  @@index([supplierId, createdAt])
  @@index([orderId])
  @@map("non_conformities")
}

/// Bon de retour fournisseur (P2) : marchandise déjà entrée en stock.
model SupplierReturn {
  id          String               @id @default(cuid())
  /// RET-AAAA-NNNNN.
  number      String               @unique
  status      SupplierReturnStatus @default(VALIDE)
  supplierId  String               @map("supplier_id")
  orderId     String               @map("order_id")
  warehouseId String               @map("warehouse_id")
  reason      String
  returnedAt  DateTime             @map("returned_at") @db.Date
  createdById String               @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")

  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  order     PurchaseOrder        @relation(fields: [orderId], references: [id])
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  createdBy User                 @relation(fields: [createdById], references: [id])
  lines     SupplierReturnLine[]

  @@index([orderId])
  @@index([supplierId, returnedAt])
  @@map("supplier_returns")
}

model SupplierReturnLine {
  id          String  @id @default(cuid())
  returnId    String  @map("return_id")
  orderLineId String  @map("order_line_id")
  itemId      String  @map("item_id")
  /// Unité de stock.
  quantity    Decimal @db.Decimal(14, 3)
  unitCost    Decimal @map("unit_cost") @db.Decimal(14, 4)
  value       Int

  return SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item   Item           @relation(fields: [itemId], references: [id])

  @@index([returnId])
  @@map("supplier_return_lines")
}

model StockLevel {
  id          String   @id @default(cuid())
  itemId      String   @map("item_id")
  warehouseId String   @map("warehouse_id")
  /// Unité de stock. Modifié uniquement par applyMovement (src/modules/stock/movements.ts).
  quantity    Decimal  @default(0) @db.Decimal(14, 3)
  /// Prix moyen pondéré, FCFA par unité de stock.
  pmp         Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([itemId, warehouseId])
  @@index([warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id            String            @id @default(cuid())
  itemId        String            @map("item_id")
  warehouseId   String            @map("warehouse_id")
  type          StockMovementType
  /// Signée, unité de stock.
  quantity      Decimal           @db.Decimal(14, 3)
  unitCost      Decimal           @map("unit_cost") @db.Decimal(14, 4)
  /// FCFA entiers, signée (quantité x coût unitaire, arrondie).
  value         Int
  pmpBefore     Decimal           @map("pmp_before") @db.Decimal(14, 4)
  pmpAfter      Decimal           @map("pmp_after") @db.Decimal(14, 4)
  stockAfter    Decimal           @map("stock_after") @db.Decimal(14, 3)
  documentType  StockDocumentType @map("document_type")
  documentId    String?           @map("document_id")
  documentRef   String            @map("document_ref")
  receiptLineId String?           @map("receipt_line_id")
  issueLineId   String?           @map("issue_line_id")
  /// Mouvement annulé par celui-ci (contre-passation) ; un mouvement ne s'annule qu'une fois.
  reversalOfId  String?           @unique @map("reversal_of_id")
  comment       String?
  occurredAt    DateTime          @map("occurred_at")
  createdById   String            @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  item        Item            @relation(fields: [itemId], references: [id])
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy   User            @relation(fields: [createdById], references: [id])
  receiptLine ReceiptLine?    @relation(fields: [receiptLineId], references: [id])
  issueLine   StockIssueLine? @relation(fields: [issueLineId], references: [id])
  reversalOf  StockMovement?  @relation("MovementReversal", fields: [reversalOfId], references: [id])
  reversedBy  StockMovement?  @relation("MovementReversal")

  @@index([itemId, occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([type, occurredAt])
  @@index([documentType, documentId])
  @@map("stock_movements")
}

model StockIssue {
  id              String           @id @default(cuid())
  /// SOR-AAAA-NNNNN.
  number          String           @unique
  status          StockIssueStatus @default(VALIDEE)
  warehouseId     String           @map("warehouse_id")
  departmentId    String           @map("department_id")
  requesterName   String           @map("requester_name")
  reason          String
  equipment       String?
  issuedAt        DateTime         @map("issued_at") @db.Date
  createdById     String           @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  cancelledAt     DateTime?        @map("cancelled_at")
  cancelledById   String?          @map("cancelled_by_id")
  cancelledReason String?          @map("cancelled_reason")

  warehouse  Warehouse        @relation(fields: [warehouseId], references: [id])
  department Department       @relation(fields: [departmentId], references: [id])
  createdBy  User             @relation(fields: [createdById], references: [id])
  lines      StockIssueLine[]

  @@index([issuedAt])
  @@index([departmentId, issuedAt])
  @@map("stock_issues")
}

model StockIssueLine {
  id       String  @id @default(cuid())
  issueId  String  @map("issue_id")
  itemId   String  @map("item_id")
  quantity Decimal @db.Decimal(14, 3)
  unitCost Decimal @map("unit_cost") @db.Decimal(14, 4)
  value    Int

  issue     StockIssue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  item      Item            @relation(fields: [itemId], references: [id])
  movements StockMovement[]

  @@index([issueId])
  @@index([itemId])
  @@map("stock_issue_lines")
}

// ------------------------------------------------------------------ LOT-11 : inventaires

enum InventoryCountStatus {
  PREPARE
  EN_COMPTAGE
  A_VALIDER
  VALIDE
  ANNULE
}

enum InventoryCountKind {
  TOURNANT
  COMPLET
}

model InventoryCount {
  id             String               @id @default(cuid())
  /// INV-AAAA-0001.
  number         String               @unique
  status         InventoryCountStatus @default(PREPARE)
  kind           InventoryCountKind   @default(TOURNANT)
  warehouseId    String               @map("warehouse_id")
  /// Date prévue du comptage (jour, Abidjan).
  plannedFor     DateTime?            @map("planned_for") @db.Date
  /// Seuils figés à la création : écart > pourcentage OU > valeur (FCFA) => recomptage puis motif.
  thresholdPct   Decimal              @map("threshold_pct") @db.Decimal(5, 2)
  thresholdValue Int                  @map("threshold_value")
  comment        String?
  createdById    String               @map("created_by_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  /// Ouverture du comptage : le théorique est figé à cet instant.
  openedAt       DateTime?            @map("opened_at")
  openedById     String?              @map("opened_by_id")
  submittedAt    DateTime?            @map("submitted_at")
  submittedById  String?              @map("submitted_by_id")
  validatedAt    DateTime?            @map("validated_at")
  validatedById  String?              @map("validated_by_id")
  /// % d'articles sans écart, figé à la validation.
  reliabilityPct Decimal?             @map("reliability_pct") @db.Decimal(5, 2)
  cancelledAt     DateTime?           @map("cancelled_at")
  cancelledById   String?             @map("cancelled_by_id")
  cancelledReason String?             @map("cancelled_reason")

  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])
  createdBy   User                 @relation("InventoryCreator", fields: [createdById], references: [id])
  validatedBy User?                @relation("InventoryValidator", fields: [validatedById], references: [id])
  lines       InventoryCountLine[]

  @@index([status, createdAt])
  @@index([warehouseId, status])
  @@map("inventory_counts")
}

model InventoryCountLine {
  id              String    @id @default(cuid())
  countId         String    @map("count_id")
  itemId          String    @map("item_id")
  /// Pourquoi l'article est sur la liste : CLASSE_A, CLASSE_B, CLASSE_C, ECART_RECENT, AJOUT_MANUEL, COMPLET.
  selectionReason String    @map("selection_reason")
  /// Figés à l'ouverture du comptage ; JAMAIS envoyés au magasinier (comptage aveugle).
  theoreticalQty  Decimal?  @map("theoretical_qty") @db.Decimal(14, 3)
  pmp             Decimal?  @db.Decimal(14, 4)
  countedQty      Decimal?  @map("counted_qty") @db.Decimal(14, 3)
  countedById     String?   @map("counted_by_id")
  countedAt       DateTime? @map("counted_at")
  recountQty      Decimal?  @map("recount_qty") @db.Decimal(14, 3)
  recountById     String?   @map("recount_by_id")
  recountAt       DateTime? @map("recount_at")
  /// Écart au-dessus du seuil au premier comptage et pas encore recompté.
  recountRequired Boolean   @default(false) @map("recount_required")
  /// Motif de l'écart important (obligatoire à la validation).
  varianceReason  String?   @map("variance_reason")
  /// Au moins un mouvement de stock sur l'article/dépôt depuis l'ouverture du comptage.
  movedDuringCount Boolean  @default(false) @map("moved_during_count")
  /// Mouvement AJUSTEMENT_INVENTAIRE créé à la validation.
  adjustmentMovementId String? @unique @map("adjustment_movement_id")

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item  Item           @relation(fields: [itemId], references: [id])

  @@unique([countId, itemId])
  @@index([itemId])
  @@map("inventory_count_lines")
}
