# Copier en .env et renseigner les vraies valeurs. Ne jamais committer .env.

# --- Base de données PostgreSQL ---
# Base de développement
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/richbond"
# Base de test (tests d'intégration et Playwright) : DOIT être différente de DATABASE_URL
DATABASE_URL_TEST="postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/richbond_test"

# --- Authentification (Auth.js, LOT-01) ---
# Générer avec : npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Coût bcrypt (facultatif, défaut du code)
# BCRYPT_COST="12"

# --- Application ---
TZ="Africa/Abidjan"
# Mot de passe des comptes fictifs du seed (obligatoire : le seed s'arrête sans)
SEED_DEFAULT_PASSWORD=""

# --- Licence / période d'essai (LOT-02) ---
# Secret de génération des clés : 32 caractères aléatoires minimum, à garder pour soi, ne jamais changer après activation.
LICENSE_SECRET=""
# Fin d'essai AAAA-MM-JJ (23:59 heure d'Abidjan) OU durée en jours (1-365). Lues uniquement à la création de la licence.
TRIAL_END_DATE=""
TRIAL_DAYS="30"
# Coordonnées affichées dans la fenêtre d'essai et le bandeau d'expiration (facultatif)
CONTACT_EMAIL=""
CONTACT_PHONE=""
# Horloge simulée pour les tests uniquement. Ne JAMAIS définir en production.
# ALLOW_TEST_NOW="1"
# TEST_NOW="2026-12-31T10:00:00Z"

# --- Tâches planifiées (alertes 8h / 15h, LOT-16) ---
CRON_SECRET=""

# --- Email (facultatif, LOT-16) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# --- Intégration Sage 100 (LOT-17) ---
# SAGE_EXPORT_DIR=""
# SAGE_IMPORT_DIR=""

# LOT-16 : secret des appels planifies /api/cron/alertes (Authorization: Bearer ...). Obligatoire pour activer les alertes 8h/15h.
# CRON_SECRET=
# Copie email des alertes (prevue, non implementee) :
# ALERT_EMAIL_COPY=1
