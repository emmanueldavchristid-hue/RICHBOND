# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# Base PostgreSQL de développement (créer la base "richbond" avant)
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/richbond?schema=public"
# Base dédiée aux tests automatiques (créer la base "richbond_test")
DATABASE_URL_TEST="postgresql://postgres:MOT_DE_PASSE@localhost:5432/richbond_test?schema=public"

# Authentification (générer une valeur aléatoire longue : npx auth secret)
AUTH_SECRET="a-remplacer"
AUTH_URL="http://localhost:3000"

# Période d'essai (date de fin au format AAAA-MM-JJ) ou durée en jours si la date est vide
TRIAL_END_DATE=""
TRIAL_DAYS="30"
# Secret de génération des clés de licence (garder pour soi, ne jamais transmettre au client)
LICENSE_SECRET="a-remplacer-par-une-longue-valeur-aleatoire"

# Secret des tâches planifiées (alertes 8h / 15h)
CRON_SECRET="a-remplacer"

# Fuseau horaire
TZ="Africa/Abidjan"

# Email (facultatif, désactivé par défaut)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
